{
	"schemaVersion": 1,
	"id": "camera-mod",
	"version": "${version}",
	"name": "Camera Mod",
	"description": "A simulated-photography mod: thin-lens depth of field, real metering and 8K float TIFF with full EXIF. 模拟摄影模组：物理景深、真实测光，输出 8K 浮点 TIFF。",
	"authors": [
		"ColaIce"
	],
	"contact": {
		"homepage": "https://github.com/echou114514/minecraft-camera-mod",
		"sources": "https://github.com/echou114514/minecraft-camera-mod"
	},
	"license": "CC0-1.0",
	"icon": "assets/camera-mod/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"com.example.camera.CameraMod"
		],
		"client": [
			"com.example.camera.client.CameraModClient"
		],
		"modmenu": [
			"com.example.camera.client.config.CameraModModMenu"
		]
	},
	"mixins": [
		{
			"config": "camera-mod.client.mixins.json",
			"environment": "client"
		},
		{
			"config": "camera-mod.iris.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": "~1.21.1",
		"java": ">=21",
		"fabric-api": ">=0.116.0",
		"geckolib": ">=4.8.4"
	},
	"suggests": {
		"sodium": "*",
		"iris": "*",
		"modmenu": "*"
	}
}
